engine-strict=true
# Solo resuelve versiones publicadas hace 1+ dia (en minutos), el valor por
# defecto de pnpm 11: da margen a que se retire un paquete comprometido. En
# pnpm 10 es estricto: si una dependencia no tiene una version tan vieja, la
# instalacion falla; espera o agregala a minimum-release-age-exclude.
# No afecta a --frozen-lockfile, y Dependabot lo omite en security updates.
minimum-release-age=1440
