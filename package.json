{
	"name": "monfly-v2",
	"private": true,
	"version": "1.8.0",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:production": "drizzle-kit migrate --config=drizzle.production.config.ts",
		"db:pull": "drizzle-kit pull --config=drizzle.pull.config.ts",
		"db:studio": "drizzle-kit studio",
		"lint": "oxfmt --check && eslint .",
		"format": "oxfmt",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-mcp": "^10.6.0",
		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/addon-themes": "^10.6.0",
		"@storybook/sveltekit": "^10.6.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "4.3.3",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.67.0",
		"storybook": "^10.6.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@animated-color-icons/lucide-svelte": "1.0.0",
		"@auth0/auth0-server-js": "1.13.0",
		"@blobatar/svelte": "2.7.0",
		"@floating-ui/dom": "1.8.0",
		"@fontsource-variable/outfit": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@jis3r/icons": "2.9.0",
		"@lucide/svelte": "1.43.0",
		"@neondatabase/serverless": "1.1.0",
		"@tanstack/svelte-query": "6.1.48",
		"@tanstack/svelte-table": "9.2.4",
		"bits-ui": "2.19.2",
		"blobatar": "2.7.0",
		"clsx": "2.1.1",
		"dotenv": "17.4.2",
		"drizzle-orm": "1.0.0-rc.4",
		"gsap": "3.15.0",
		"mode-watcher": "1.1.0",
		"motion": "13.2.0",
		"svelte-animated-icons": "1.0.0",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.{json,jsonc,md,yml,yaml,css,html}": "oxfmt --no-error-on-unmatched-pattern"
	}
}
