# Neon Postgres, shared with monfly-v1 (Prisma owns its migrations).
DATABASE_URL=

# Auth0 — a "Regular Web Application" (Dashboard → Applications → Create).
#   Allowed Callback URLs: http://localhost:5173/auth/callback
#   Allowed Logout URLs:   http://localhost:5173/
# Leave these empty and dev falls back to a placeholder session.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts the session and transaction cookies. Long and random: openssl rand -hex 32
AUTH0_SECRET=
